BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Allman
NamespaceIndentation: All
PointerAlignment: Right
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<jetio/'
    Priority: 1
  - Regex: '^<[a-z_]+(/[a-z_]+)*\.(h|hpp)>$'
    Priority: 2
  - Regex: '^<[a-z_]+>$'
    Priority: 3
